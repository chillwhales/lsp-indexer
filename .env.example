# LSP Indexer v3 Docker Compose configuration
#
# Local development may leave values blank and use the safe local defaults in
# docker/docker-compose.yml. Production rejects blank secrets and requires an
# immutable INDEXER_VERSION. Generate URL-safe passwords with:
#   openssl rand -hex 32

COMPOSE_PROJECT_NAME=lsp-indexer-v3

# Production image and service credentials
INDEXER_VERSION=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=lsp_indexer_v3
POSTGRES_PORT=5432
DATABASE_RUNTIME_PASSWORD_LUKSO_MAINNET=
DATABASE_RUNTIME_PASSWORD_ETHEREUM_MAINNET=
DATABASE_RUNTIME_PASSWORD_ETHEREUM_SEPOLIA=
DATABASE_API_PASSWORD=
HASURA_GRAPHQL_ADMIN_SECRET=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Login names are provisioned before the one-shot migration. Keep each runtime
# login distinct; migrations grant it exactly one generated writer role.
DATABASE_RUNTIME_LOGIN_LUKSO_MAINNET=lsp_v3_lukso_mainnet
DATABASE_RUNTIME_LOGIN_ETHEREUM_MAINNET=lsp_v3_ethereum_mainnet
DATABASE_RUNTIME_LOGIN_ETHEREUM_SEPOLIA=lsp_v3_ethereum_sepolia
DATABASE_API_LOGIN=lsp_v3_hasura
DATABASE_MIGRATION_NETWORKS=lukso-mainnet,ethereum-mainnet

# Network sources. Private production RPC endpoints are strongly recommended.
RPC_URL_LUKSO_MAINNET=
RPC_URL_ETHEREUM_MAINNET=
RPC_URL_ETHEREUM_SEPOLIA=
SQD_PORTAL_URL_LUKSO_MAINNET=https://portal.sqd.dev/datasets/lukso-mainnet
SQD_PORTAL_URL_ETHEREUM_MAINNET=https://portal.sqd.dev/datasets/ethereum-mainnet
INDEXER_SOURCE_MODE_LUKSO_MAINNET=fallback
INDEXER_SOURCE_MODE_ETHEREUM_MAINNET=fallback
INDEXER_RPC_RATE_LIMIT_LUKSO_MAINNET=10
INDEXER_RPC_RATE_LIMIT_ETHEREUM_MAINNET=10
INDEXER_FROM_BLOCK_LUKSO_MAINNET=0
INDEXER_FROM_BLOCK_ETHEREUM_MAINNET=0
INDEXER_TO_BLOCK_LUKSO_MAINNET=
INDEXER_TO_BLOCK_ETHEREUM_MAINNET=

# Fallback health policy
INDEXER_SOURCE_RETRIES=2
INDEXER_SOURCE_STALL_TIMEOUT_MS=30000
INDEXER_SOURCE_MAX_LAG_BLOCKS=10
INDEXER_SOURCE_ALL_DOWN_TIMEOUT_MS=300000

# PostgreSQL runtime limits
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=60000
DATABASE_LOCK_TIMEOUT_MS=10000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=60000
DATABASE_UNFINALIZED_BLOCKS_RETENTION=1000

# Metadata workers
METADATA_IPFS_GATEWAYS_LUKSO_MAINNET=https://api.universalprofile.cloud/ipfs/
METADATA_IPFS_GATEWAYS_ETHEREUM_MAINNET=https://ipfs.io/ipfs/
METADATA_CONCURRENCY=8
METADATA_POLL_INTERVAL_MS=1000
METADATA_REQUEST_TIMEOUT_MS=15000
METADATA_MAX_RESPONSE_BYTES=2097152
METADATA_MAX_REDIRECTS=3
METADATA_MAX_ATTEMPTS=6
METADATA_RETRY_BASE_MS=5000
METADATA_RETRY_MAX_MS=1800000
METADATA_LEASE_TIMEOUT_MS=300000
METADATA_ALLOW_HTTP=false

# API and dashboards
HASURA_GRAPHQL_PORT=8080
HASURA_GRAPHQL_ENABLE_CONSOLE=true
HASURA_GRAPHQL_DEV_MODE=true
HASURA_GRAPHQL_ENABLED_LOG_TYPES=startup,http-log,webhook-log,websocket-log,query-log
HASURA_GRAPHQL_UNAUTHORIZED_ROLE=public
GRAFANA_PORT=3000

# Shadow-production acceptance commands (not consumed by Docker Compose).
# V2_GRAPHQL_ENDPOINT=https://v2-shadow.example.com/v1/graphql
# V2_GRAPHQL_ADMIN_SECRET=
# V3_GRAPHQL_ENDPOINT=https://v3-shadow.example.com/v1/graphql
# V3_GRAPHQL_ADMIN_SECRET=
# ACCEPTANCE_NETWORK=lukso-mainnet
# ACCEPTANCE_FINALIZED_BLOCK=8230000
# ACCEPTANCE_PAGE_SIZE=1000
# ACCEPTANCE_MAX_ROWS_PER_DOMAIN=1000000
# ACCEPTANCE_METRICS_TARGETS=[]
# ACCEPTANCE_OBSERVATION_SECONDS=86400
# ACCEPTANCE_MINIMUM_EVIDENCE_SECONDS=86400
# ACCEPTANCE_SCRAPE_INTERVAL_SECONDS=30
# ACCEPTANCE_MAXIMUM_SCRAPE_FAILURES=0
# ACCEPTANCE_REQUEST_TIMEOUT_MS=10000
